# Package set for the AedwenOS live/install medium.
#
# Model A: this file is the single source of truth for the installed system.
# Calamares clones the live filesystem to disk (unpackfs) and then removes the
# packages marked "LIVE ONLY" below (see iso/airootfs/etc/calamares/modules/
# packages.conf). The command-line installer (aedwen-install) installs the
# non-LIVE-ONLY set directly.
#
# NOTE: keep every note on its own line -- this mkarchiso leaves trailing
# whitespace when it strips an inline "# comment", which breaks the target.

## base system
base
base-devel
linux-firmware
sof-firmware
intel-ucode
amd-ucode
# dracut: initramfs generator for the installed system
dracut
# zram-generator: compressed RAM swap for day-to-day overflow, alongside the
# real disk swap partition used only for hibernation -- see
# iso/airootfs/etc/systemd/zram-generator.conf
zram-generator

## kernel: Zen (official repo)
linux-zen
# linux-zen-headers: kept for future DKMS modules (e.g. GPU drivers)
linux-zen-headers

## filesystems
# btrfs-progs: root filesystem
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g

## bootloader
limine
efibootmgr

## networking
networkmanager
iwd
wireless-regdb
openssh

## audio
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
# alsa-utils: alsamixer/aplay/etc. for low-level debugging under PipeWire
alsa-utils

## boot splash
# plymouth: branded boot splash for both the live medium (mkinitcpio) and the
# installed system (dracut). Theme + default set under airootfs/{usr/share,etc}.
plymouth

## graphics -- open-source GPU acceleration (mesa itself comes in transitively
## via plasma-desktop, but the hardware-specific Vulkan/VA-API drivers do
## not, so they're listed explicitly). Nvidia is intentionally left out: it
## needs proprietary/nvidia-open drivers picked per-hardware, not shipped
## blind on a general-purpose ISO. VDPAU support is built into mesa itself
## now (no separate mesa-vdpau split/virtual package exists any more).
## Repo-qualified (extra/...): chaotic-aur's mesa-tkg-git Provides= these
## same names, which otherwise turns each into an interactive "which
## provider" prompt and can resolve inconsistently across them, leaving a
## mix of official mesa and mesa-tkg-git packages that Conflicts= each
## other and aborts the transaction. Qualifying the repo removes the
## ambiguity outright instead of relying on IgnorePkg to catch it.
extra/vulkan-intel
extra/vulkan-radeon
extra/libva-mesa-driver

## desktop -- KDE Plasma
## Explicit list instead of plasma-meta, so the session is exactly what the
## AedwenOS theme is built on. Left out of plasma-meta on purpose:
##   discover             -- octopi is the package GUI (see below)
##   plasma-login-manager -- sddm is the display manager (sddm.conf.d)
##   plasma-welcome       -- KDE-branded first-run wizard
##   oxygen, oxygen-sounds -- alternate theme; AedwenOS themes on top of Breeze
##   flatpak-kcm          -- flatpak is not installed by default
##   krdp, plasma-vault   -- remote-desktop server / encrypted vaults: niche
## Re-check this list against `pacman -Si plasma-meta` on each Plasma
## feature release -- new core components appear there first.
plasma-workspace
plasma-desktop
kwin
systemsettings
powerdevil
polkit-kde-agent
kscreenlocker
kglobalacceld
kactivitymanagerd
plasma-activities
plasma-activities-stats
plasma-integration
plasma-browser-integration
kdeplasma-addons
kde-cli-tools
kmenuedit
milou
kwallet-pam
ksshaskpass
kwrited
drkonqi
ksystemstats
libksysguard
kpipewire
layer-shell-qt
kwayland
kdecoration
libkscreen
libplasma
knighttime
plasma-keyboard
plasma-disks
plasma-thunderbolt
# plasma-firewall: System Settings page for firewalld (enabled by default)
plasma-firewall
# breeze: widget style, Plasma theme and cursors the AedwenOS look-and-feel
# builds on (widgetStyle=Breeze, cursorTheme=breeze_cursors) -- required
breeze
breeze-gtk
aurorae
# ocean-sound-theme: fallback for events the AedwenOS sound theme doesn't cover
ocean-sound-theme
plasma-nm
plasma-pa
kscreen
sddm
xdg-desktop-portal-kde
xdg-user-dirs
noto-fonts
noto-fonts-emoji
ttf-dejavu

## AedwenOS System Surfaces theme: UI font + monospace used across the
## Qt widget style, GTK theme and installer (design calls for Roboto Flex,
## a variable-font superset; ttf-roboto is the closest official-repo match
## until an aedwen-local package for the variable font is built)
ttf-roboto
ttf-roboto-mono

## KDE application suite (curated)
konsole
dolphin
kate
ark
gwenview
okular
spectacle
kcalc
kfind
filelight
kinfocenter
plasma-systemmonitor
kwalletmanager
kde-gtk-config
partitionmanager
# print-manager: KDE's printer-config GUI. cups is the actual print
# server/daemon underneath it -- print-manager only depends on libcups (the
# client library), so both are needed for printing to work at all.
print-manager
cups
power-profiles-daemon
# bluedevil: KDE's Bluetooth applet. It only depends on bluez-qt (the
# Qt/DBus client library), not the bluetoothd daemon -- bluez provides that,
# bluez-utils adds bluetoothctl + the systemd service. Without both,
# bluedevil has nothing to talk to.
bluedevil
bluez
bluez-utils

## shell + package tools
# fish: default user shell (bash from `base` is the fallback)
fish
# paru: AUR helper (from chaotic-aur -- see pacman.conf)
paru

## browser
# zen-browser-bin: prebuilt from chaotic-aur, same repo as paru above
zen-browser-bin
# octopi: Qt6 pacman/AUR GUI frontend, prebuilt from chaotic-aur. Picked over
# Plasma Discover, whose pacman support runs through PackageKit's alpm backend
# and is widely reported as unreliable for real transactions on Arch.
octopi
# chaotic-aur repo config, kept on the installed system so [chaotic-aur] in
# /etc/pacman.conf resolves. The signing key is trusted at ISO build time.
chaotic-keyring
chaotic-mirrorlist
git
nano
sudo
reflector

## developer tooling
fastfetch
python
# uv: fast Python package/venv/version manager (single binary, no AUR needed) --
# picked over python-pip as the default entry point for Python dev
uv
nodejs
npm
ncdu

## CLI tooling
# note: base already pulls in iproute2, iputils, tar, gzip -- not listed again here
# man-db + man-pages: local documentation. less: the pager man/git/etc. need --
# not pulled in by anything else on this list (only an optional dep of git/gzip).
man-db
man-pages
less
curl
wget
jq
ripgrep
fd
bat
eza
tmux
# github-cli: provides the `gh` command
github-cli
# strace/gdb: syscall tracing + debugging, both actively maintained.
# ltrace (library-call tracing) deliberately left out: unmaintained upstream
# and commonly broken on modern glibc/PIE/hardened builds.
strace
gdb
zip
unzip
# 7zip: .7z archive support (replaced p7zip in the official repos), alongside zip/unzip
7zip
zstd
fzf

## snapshots + rollback
# snapper: Btrfs snapshot management. @snapshots is already a dedicated
# subvolume (see aedwen-install / partition.conf) -- config is shipped
# directly rather than via `snapper create-config` (would conflict with the
# pre-existing subvolume).
snapper
# snap-pac: automatic pre/post snapshot pair around every pacman transaction
snap-pac
# limine-snapper-sync: adds bootable snapshot entries to the Limine menu
# (from chaotic-aur). Works as a snapper plugin, no extra service needed.
limine-snapper-sync
# btrfs-assistant: GUI for browsing/restoring snapper snapshots and managing
# Btrfs subvolumes
btrfs-assistant

## firewall
firewalld

## AppStream metadata (Kickoff's application grid reads this cache; KRunner
## search bypasses it and scans .desktop files directly, which is why search
## works even when the grid appears empty with a stale/missing cache)
appstream

## ------------------------------------------------------------------ LIVE ONLY
## Present on the ISO to run the installer; removed from the installed system.
## archiso builds the live initramfs with mkinitcpio + the archiso hooks:
mkinitcpio
mkinitcpio-archiso
# syslinux: ISO BIOS boot
syslinux
edk2-shell
# calamares + ckbcomp (its keyboard module): from [aedwen-local], built by
# scripts/build-localrepo.sh -- no longer in the official repos.
calamares
ckbcomp
# os-prober: Calamares' partition module (via KPMcore) calls this itself to
# detect other installed OSes and power the "Install alongside" option on the
# partitioning screen -- no extra config needed, it's automatic upstream
# behavior. LIVE ONLY because it has no job after install: Limine does not
# use os-prober for its own boot menu (see partition.conf/limine.conf, which
# are hand-written, not os-prober-driven).
os-prober
squashfs-tools
# arch-install-scripts: pacstrap/genfstab for the installers
arch-install-scripts
gptfdisk
parted
