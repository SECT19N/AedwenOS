/* Generated by scripts/generate-calamares-branding.py -- do not edit by hand.
 * Qt-widget pages (Disk step), styled per "App widgets" in the AedwenOS
 * System Surfaces design: 36px pill buttons, outlined fields, 8% state layer. */

QWidget {
    font-family: "Roboto";
}

QPushButton {
    min-height: 36px;
    padding: 0 18px;
    border: none;
    border-radius: 18px;
    background-color: #37304e;
    color: #dfdbed;
    font-weight: 600;
}
QPushButton:hover { background-color: #262331; }
QPushButton:default {
    background-color: #cdacff;
    color: #2d1c50;
}
QPushButton:disabled {
    background-color: rgba(229, 227, 236, 0.12);
    color: rgba(229, 227, 236, 0.45);
}
QToolButton {
    min-height: 32px;
    min-width: 32px;
    border: none;
    border-radius: 16px;
    background: transparent;
    color: #e5e3ec;
}
QToolButton:hover { background-color: rgba(229, 227, 236, 0.08); }

QLineEdit, QComboBox, QSpinBox {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #878491;
    border-radius: 10px;
    background: transparent;
    color: #e5e3ec;
    selection-background-color: #cdacff;
    selection-color: #2d1c50;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #cdacff;
    padding: 0 11px;
}
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    padding: 4px;
    border: none;
    border-radius: 16px;
    background-color: #1f1c29;
    color: #e5e3ec;
    selection-background-color: #37304e;
    selection-color: #dfdbed;
    outline: 0;
}

QTreeView, QListView, QTableView {
    border: 1px solid #3e3b47;
    border-radius: 10px;
    background-color: #12101b;
    alternate-background-color: #12101b;
    selection-background-color: #37304e;
    selection-color: #dfdbed;
    outline: 0;
}
QHeaderView::section {
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #3e3b47;
    background: transparent;
    color: #bebbcd;
    font-weight: 600;
}

QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 2px; }
QScrollBar::handle { background: #878491; border-radius: 3px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none; border: none; width: 0; height: 0;
}

QToolTip {
    padding: 6px 10px;
    border: none;
    border-radius: 8px;
    background-color: #e5e3ec;
    color: #0d0b13;
}

QProgressBar {
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background-color: #37304e;
    color: transparent;
}
QProgressBar::chunk { border-radius: 4px; background-color: #cdacff; }
