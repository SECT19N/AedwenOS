/* Generated by scripts/generate-calamares-branding.py -- do not edit by hand.
 * Qt-widget pages (Disk step), styled per "App widgets" in the AedwenOS
 * System Surfaces design: 36px pill buttons, outlined fields, 8% state layer. */

QWidget {
    font-family: "Roboto";
}

QPushButton {
    min-height: 36px;
    padding: 0 18px;
    border: none;
    border-radius: 18px;
    background-color: #37304e;
    color: #dfdbed;
    font-weight: 600;
}
QPushButton:hover { background-color: #262331; }
QPushButton:default {
    background-color: #cdacff;
    color: #2d1c50;
}
QPushButton:disabled {
    background-color: rgba(229, 227, 236, 0.12);
    color: rgba(229, 227, 236, 0.45);
}
QToolButton {
    min-height: 32px;
    min-width: 32px;
    border: none;
    border-radius: 16px;
    background: transparent;
    color: #e5e3ec;
}
QToolButton:hover { background-color: rgba(229, 227, 236, 0.08); }

QLineEdit, QComboBox, QSpinBox {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #878491;
    border-radius: 10px;
    background: transparent;
    color: #e5e3ec;
    selection-background-color: #cdacff;
    selection-color: #2d1c50;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #cdacff;
    padding: 0 11px;
}
QComboBox::drop-down { border: none; width: 28px; }
QComboBox QAbstractItemView {
    padding: 4px;
    border: none;
    border-radius: 16px;
    background-color: #1f1c29;
    color: #e5e3ec;
    selection-background-color: #37304e;
    selection-color: #dfdbed;
    outline: 0;
}

QTreeView, QListView, QTableView {
    border: 1px solid #3e3b47;
    border-radius: 10px;
    background-color: #12101b;
    alternate-background-color: #12101b;
    selection-background-color: #37304e;
    selection-color: #dfdbed;
    outline: 0;
}
QHeaderView::section {
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid #3e3b47;
    background: transparent;
    color: #bebbcd;
    font-weight: 600;
}

QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 2px; }
QScrollBar::handle { background: #878491; border-radius: 3px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none; border: none; width: 0; height: 0;
}

QToolTip {
    padding: 6px 10px;
    border: none;
    border-radius: 8px;
    background-color: #e5e3ec;
    color: #0d0b13;
}

/* Widget pages sit on the same 32 px side / 28 px top inset as the QML
 * pages and the navigation bar. ChoicePage (the Disk step) lives in a
 * QStackedWidget inside the view stack; the install step's slideshow is a
 * QTabWidget, whose own inner stack must stay unpadded. */
#viewManagerStack QStackedWidget { padding: 28px 32px 0 32px; }
#viewManagerStack QStackedWidget#qt_tabwidget_stackedwidget { padding: 0; }

/* Install step (Calamares ExecutionViewStep): progress bar, log button and
 * status line aligned with the slideshow card's 32 px inset. No QProgressBar
 * colours here on purpose: the Aedwen widget style (packages/aedwen-qstyle)
 * draws the design's Expressive wavy bar -- gap at the value, thin track,
 * stop dot -- and any QSS colour or chunk rule would replace it. The
 * percentage is hidden as the design shows none inside the bar. */
#slideshow QProgressBar#exec-progress {
    margin-left: 32px;
    qproperty-textVisible: false;
}
#slideshow QToolBar {
    border: none;
    background: transparent;
}
/* QToolBar ignores margin/padding here; the button's own margin does it */
#slideshow QToolBar QToolButton {
    margin-right: 16px;
    min-width: 36px;
    min-height: 36px;
}
#slideshow QLabel#exec-message {
    margin: 2px 32px 0 32px;
    color: #bebbcd;
    font-size: 13px;
}
