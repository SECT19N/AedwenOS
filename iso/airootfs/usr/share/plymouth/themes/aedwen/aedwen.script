// AedwenOS Plymouth theme (script module).
// Centred eagle mark (violet, matching the System Surfaces seed) on a dark
// ground, with the same morphing loader shape used across the design's
// boot/install/first-run mockups underneath it, plus minimal message and
// password prompts so early-boot dialogs (fsck, LUKS if ever added) still show.

// AedwenOSVioletDarkExpressive --surface, see scripts/palette_lib.py
Window.SetBackgroundTopColor(0.051, 0.043, 0.075);
Window.SetBackgroundBottomColor(0.051, 0.043, 0.075);

// ---- logo ------------------------------------------------------------------
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.x = Window.GetX() + Window.GetWidth()  / 2 - logo.w / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.h / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 100);

// ---- morphing loader (pre-rendered aeMorph frames, see
// scripts/generate-plymouth-assets.py) ---------------------------------------
loader.num_frames = 32;
for (loader.i = 0; loader.i < loader.num_frames; loader.i++) {
    loader.frames[loader.i] = Image("loader/loader-" + loader.i + ".png");
}
loader.sprite = Sprite();
loader.w = loader.frames[0].GetWidth();
loader.h = loader.frames[0].GetHeight();
loader.x = Window.GetX() + Window.GetWidth() / 2 - loader.w / 2;
loader.y = logo.y + logo.h + 36;
loader.sprite.SetPosition(loader.x, loader.y, 100);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(tick / 14));
    frame_index = Math.Int(tick / 2) % loader.num_frames;
    loader.sprite.SetImage(loader.frames[frame_index]);
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---- status / fsck messages -------------------------------------------------
message.sprite = Sprite();
message.sprite.SetPosition(Window.GetX() + 20,
                           Window.GetY() + Window.GetHeight() - 40, 100);

fun display_message_callback(text) {
    message.sprite.SetImage(Image.Text(text, 0.8, 0.8, 0.8));
}
fun hide_message_callback(text) {
    message.sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

// ---- password prompt (kept simple: prompt text + bullet count) --------------
prompt.sprite = Sprite();
prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - 150,
                          loader.y + loader.h + 24, 100);

fun display_password_callback(prompt_text, bullets) {
    dots = "";
    for (i = 0; i < bullets; i++) dots += "*";
    prompt.sprite.SetImage(Image.Text(prompt_text + "  " + dots, 1, 1, 1));
}
fun display_normal_callback() {
    prompt.sprite.SetImage(Image.Text("", 0, 0, 0));
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---- shutdown / reboot -----------------------------------------------------
fun quit_callback() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);
