[Icon Theme]
Name=Aedwen-Icons
Comment=AedwenOS app icons · Themed, expressive, dark (generated by generate-icons.py)
Inherits=breeze-dark,breeze
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
