#!/usr/bin/env bash
#
# AedwenOS command-line installer.
# The graphical path is Calamares; this script is the scripted / hands-on route.
#
#   sudo aedwen-install /dev/sdX
#
# Disk layout:  GPT  ->  1 GiB FAT32 EFI system partition (/boot)  +  Btrfs root
#   kernel:      linux-zen
#   initramfs:   dracut (pkgbase-named images, driven by pacman hooks)
#   bootloader:  Limine (UEFI); kernel + initramfs are stored on the ESP
#   shell:       fish for the user, bash for root (fallback)
#   AUR helper:  paru, from the chaotic-aur repository (enabled on the target)
set -euo pipefail

DISK="${1:-}"
HOSTNAME="${HOSTNAME:-aedwenos}"
USERNAME="${USERNAME:-aedwen}"
TIMEZONE="${TIMEZONE:-UTC}"
LOCALE="${LOCALE:-en_US.UTF-8}"
KEYMAP="${KEYMAP:-us}"

CHAOTIC_KEY="3056513887B78AEB"

die() { echo "error: $*" >&2; exit 1; }

# Retry a flaky, network-touching command a few times before giving up.
retry() {
    local max=3 n=1
    until "$@"; do
        (( n++ >= max )) && return 1
        echo "  retry $((n - 1))/$((max - 1)): $*" >&2
        sleep 3
    done
}

[[ $EUID -eq 0 ]] || die "run as root"
[[ -b "$DISK" ]] || die "usage: aedwen-install /dev/sdX"

lsblk -o NAME,SIZE,MODEL "$DISK"
read -rp "ERASE ALL DATA on $DISK ? type YES: " ok
[[ "$ok" == "YES" ]] || die "aborted"

# ---------------------------------------------------------------- partitioning
wipefs -a "$DISK"
sgdisk -Z "$DISK"
sgdisk -n1:0:+1GiB -t1:ef00 -c1:EFI \
       -n2:0:0     -t2:8304 -c2:aedwen_root "$DISK"
partprobe "$DISK"

p() { [[ "$DISK" == *[0-9] ]] && echo "${DISK}p$1" || echo "${DISK}$1"; }
ESP="$(p 1)"; ROOT="$(p 2)"

mkfs.fat -F32 -n EFI "$ESP"

# ---------------------------------------------------------------- Btrfs root
mkfs.btrfs -f -L aedwen_root "$ROOT"
mount "$ROOT" /mnt
for sv in @ @home @log @pkg @snapshots; do btrfs subvolume create "/mnt/$sv"; done
umount /mnt

o="noatime,compress=zstd:1,ssd,space_cache=v2"
mount -o "$o,subvol=@" "$ROOT" /mnt
mkdir -p /mnt/{home,var/log,var/cache/pacman/pkg,.snapshots,boot}
mount -o "$o,subvol=@home"      "$ROOT" /mnt/home
mount -o "$o,subvol=@log"       "$ROOT" /mnt/var/log
mount -o "$o,subvol=@pkg"       "$ROOT" /mnt/var/cache/pacman/pkg
mount -o "$o,subvol=@snapshots" "$ROOT" /mnt/.snapshots
mount "$ESP" /mnt/boot

# ---------------------------------------------------------------- base system
# This set mirrors the non-"LIVE ONLY" entries in iso/packages.x86_64.
# chaotic-keyring/chaotic-mirrorlist are included here (not just paru) so the
# chaotic-aur signing key ships onto the target as local data -- pacman-key
# --populate below then trusts it offline, no keyserver round-trip needed.
retry pacstrap -K /mnt \
    base base-devel linux-zen linux-zen-headers linux-firmware sof-firmware \
    intel-ucode amd-ucode dracut \
    btrfs-progs dosfstools e2fsprogs exfatprogs ntfs-3g \
    limine efibootmgr \
    networkmanager iwd wireless-regdb openssh \
    pipewire pipewire-alsa pipewire-pulse pipewire-jack wireplumber \
    plymouth \
    plasma-meta plasma-desktop plasma-nm plasma-pa plasma-workspace kscreen \
    sddm xdg-desktop-portal-kde xdg-user-dirs \
    konsole dolphin kate kwrite ark gwenview okular spectacle kcalc kfind \
    filelight kinfocenter plasma-systemmonitor kdeconnect kwalletmanager \
    kde-gtk-config partitionmanager print-manager power-profiles-daemon bluedevil \
    noto-fonts noto-fonts-emoji ttf-dejavu \
    fish paru zen-browser-bin chaotic-keyring chaotic-mirrorlist git nano vim sudo reflector \
    snapper snap-pac limine-snapper-sync firewalld appstream

genfstab -U /mnt >> /mnt/etc/fstab

# Carry the AedwenOS pacman.conf + a working mirrorlist onto the target so the
# installed system can reach the repos on first boot. The general mirrorlist
# already lists several worldwide CDN mirrors (see the file) so pacman falls
# through automatically if one is unreachable -- no extra scripting needed.
install -Dm644 /etc/pacman.conf         /mnt/etc/pacman.conf
install -Dm644 /etc/pacman.d/mirrorlist /mnt/etc/pacman.d/mirrorlist
ROOT_UUID="$(blkid -s UUID -o value "$ROOT")"

# ---------------------------------------------------------------- dracut initramfs
# The live medium builds its own initramfs with mkinitcpio; the installed system
# uses dracut. Carry the helper + config over and register the pacman hooks.
install -Dm755 /usr/local/bin/aedwen-dracut.sh /mnt/usr/local/bin/aedwen-dracut.sh
install -Dm644 /etc/dracut.conf.d/aedwen.conf /mnt/etc/dracut.conf.d/aedwen.conf
install -Dm755 /usr/local/bin/aedwen-gpu-setup.sh /mnt/usr/local/bin/aedwen-gpu-setup.sh

install -Dm644 /dev/stdin /mnt/etc/pacman.d/hooks/90-dracut-install.hook <<'HOOK'
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/pkgbase

[Action]
Description = Regenerating dracut initramfs...
When = PostTransaction
Exec = /usr/local/bin/aedwen-dracut.sh install
NeedsTargets
HOOK

install -Dm644 /dev/stdin /mnt/etc/pacman.d/hooks/60-dracut-remove.hook <<'HOOK'
[Trigger]
Type = Path
Operation = Remove
Target = usr/lib/modules/*/pkgbase

[Action]
Description = Removing dracut initramfs...
When = PreTransaction
Exec = /usr/local/bin/aedwen-dracut.sh remove
NeedsTargets
HOOK

arch-chroot /mnt /bin/bash -euo pipefail <<CHROOT
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
hwclock --systohc || true
echo "$LOCALE UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=$LOCALE"   > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf
echo "$HOSTNAME"      > /etc/hostname

# ---- GPU driver (nvidia only -- AMD/Intel need nothing) ----
# Must run before the dracut build below so a detected nvidia's early-KMS
# drop-in (/etc/dracut.conf.d/nvidia.conf) is already in place for it.
/usr/local/bin/aedwen-gpu-setup.sh

# initramfs (dracut) -- pkgbase-named images matching the Limine entry
/usr/local/bin/aedwen-dracut.sh all

# ---- users: fish shell, bash stays available for root ----
grep -qx /usr/bin/fish /etc/shells || echo /usr/bin/fish >> /etc/shells
useradd -m -G wheel -s /usr/bin/fish "$USERNAME"
echo "password for $USERNAME:"; passwd "$USERNAME"
echo "root password:";          passwd
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
systemctl enable NetworkManager sddm firewalld snapper-timeline.timer snapper-cleanup.timer

# ---- chaotic-aur trust ----
# paru + chaotic-keyring + chaotic-mirrorlist were pacstrapped above, so the
# signing key already exists on-disk as local keyring data -- populate it
# offline (same mechanism archlinux-keyring uses for the core repos, no
# network involved). Only if that somehow leaves the key untrusted (e.g. a
# very stale ISO whose baked-in key predates a chaotic-aur rotation) do we
# fall back to fetching it from a keyserver, retrying across a couple of
# servers -- and even then we warn rather than abort the whole install.
pacman-key --init
# keyring name = file stem under /usr/share/pacman/keyrings/ ("chaotic.gpg")
pacman-key --populate archlinux chaotic || true

if ! pacman-key --finger "$CHAOTIC_KEY" &>/dev/null; then
    echo "warning: chaotic-aur key not found in local keyring data, falling back to network" >&2
    got=0
    for ks in keyserver.ubuntu.com hkps://keys.openpgp.org; do
        for attempt in 1 2 3; do
            pacman-key --recv-key "$CHAOTIC_KEY" --keyserver "\$ks" && { got=1; break; }
            echo "  retry \$attempt/3 against \$ks failed, retrying..." >&2
            sleep 3
        done
        [[ \$got -eq 1 ]] && break
    done
    if [[ \$got -eq 1 ]]; then
        pacman-key --lsign-key "$CHAOTIC_KEY"
    else
        echo "warning: chaotic-aur key still untrusted -- that repo won't work until fixed manually" >&2
    fi
fi

# ---- snapper ----
# @snapshots / .snapshots already exists as its own subvolume (created above),
# so `snapper create-config` would conflict with it -- ship the config
# directly instead (the documented approach for a pre-existing layout).
# Based on snapper's own upstream default-config, with TIMELINE_LIMIT_WEEKLY
# raised from 0 so timeline cleanup keeps some weekly snapshots too, on top of
# the hourly/daily/monthly defaults.
install -Dm644 /dev/stdin /etc/snapper/configs/root <<'SNAPCFG'
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
UNIQUE_NUMBERS="yes"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="3600"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="3600"
TIMELINE_LIMIT_HOURLY="10"
TIMELINE_LIMIT_DAILY="10"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="10"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="10"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="3600"
SNAPCFG
install -Dm644 /dev/stdin /etc/conf.d/snapper <<'SNAPPERCONF'
SNAPPER_CONFIGS="root"
SNAPPERCONF
chmod 750 /.snapshots

# limine-snapper-sync auto-detects the Limine entry name from /etc/os-release
# PRETTY_NAME ("AedwenOS"), but the entry written below is "AedwenOS
# (linux-zen)" -- pin it explicitly so entry targeting doesn't depend on that
# fuzzy match.
sed -i 's/^#TARGET_OS_NAME=.*/TARGET_OS_NAME="AedwenOS (linux-zen)"/' /etc/limine-snapper-sync.conf

# ---- firewalld ----
# No daemon is running inside this chroot, so use the offline editor rather
# than firewall-cmd. This only opens the port; sshd itself is not enabled.
firewall-offline-cmd --zone=public --add-service=ssh

# ---- appstream cache ----
# Kickoff's application grid reads the AppStream metadata cache; KRunner's
# search bypasses it and scans .desktop files directly -- that mismatch is
# why search finds apps but the grid can appear empty. Refresh once now so
# the first boot already has a warm cache, and keep it fresh on future
# package changes (e.g. via paru/toolbox) with a pacman hook.
appstreamcli refresh-cache --force || true
install -Dm644 /dev/stdin /etc/pacman.d/hooks/97-appstream-refresh.hook <<'HOOK'
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/share/metainfo/*
Target = usr/share/appdata/*

[Action]
Description = Refreshing AppStream metadata cache...
When = PostTransaction
Exec = /usr/bin/appstreamcli refresh-cache --force
HOOK

# ---- Limine (UEFI) ----
install -Dm644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI
efibootmgr --create --disk "$DISK" --part 1 \
    --label "AedwenOS" --loader '\EFI\BOOT\BOOTX64.EFI' --unicode || true

# nvidia_drm.modeset=1 is needed only when aedwen-gpu-setup.sh installed the
# proprietary driver above; harmless to omit, so only add it when relevant.
CMDLINE="root=UUID=$ROOT_UUID rw rootfstype=btrfs rootflags=subvol=@ quiet splash"
[[ -f /etc/aedwen-nvidia-detected ]] && CMDLINE+=" nvidia_drm.modeset=1"

cat > /boot/limine.conf <<LIMINE
timeout: 3

/AedwenOS (linux-zen)
    protocol: linux
    kernel_path: boot():/vmlinuz-linux-zen
    module_path: boot():/initramfs-linux-zen.img
    cmdline: \$CMDLINE
LIMINE

# Redeploy the Limine EFI binary automatically whenever the package updates.
# (Kernel/initramfs paths are static, so kernel upgrades need no action.)
install -Dm644 /dev/stdin /etc/pacman.d/hooks/95-limine-deploy.hook <<HOOK
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = limine

[Action]
Description = Deploying Limine to the EFI system partition...
When = PostTransaction
Exec = /usr/bin/install -Dm644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/BOOTX64.EFI
HOOK
CHROOT

umount -R /mnt
echo
echo "Done. Remove the medium and reboot."
echo "After first boot: pacman -Syu / paru -Syu  keeps it current -- no reinstall needed."
