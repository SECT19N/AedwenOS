#!/usr/bin/env python3
"""
Pick an AedwenOS cursor theme (System Surfaces design, "Cursors · Aedwen").

The ISO ships every shape family in the dark and light styles
(/usr/share/icons/Aedwen-<Family>-<Style>). The accent and tonal styles are
drawn in the accent colour, so they're built here, into
~/.local/share/icons, from the current KDE accent colour, by the same
generator the ISO build uses (/usr/lib/aedwen/generate-cursors.py).

    aedwen-cursors --family pebble --style accent [--size 32]
    aedwen-cursors --refresh     # rebuild the current accent/tonal theme
                                 # if the accent changed (run by
                                 # aedwen-cursor-accent.path)
    aedwen-cursors --list

The Aedwen Settings app and the systemd user path unit call this; it's
also fine to run by hand.
"""

import argparse
import os
import shutil
import subprocess
import sys

LIB = "/usr/lib/aedwen"
sys.path.insert(0, LIB)

FAMILIES = ("classic", "soft", "expressive", "pebble")
STYLES = ("dark", "light", "accent", "tonal")
GENERATED = ("accent", "tonal")
SIZES = (24, 32, 48, 64)

DATA = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "aedwen")
STAMP = os.path.join(CACHE, "cursor-accent")


def stamp_for(seed):
    """The accent plus palette_lib.GENERATOR_VERSION, so the cursors are redrawn
    after an update that changes the generator, not only when the accent does."""
    try:
        from palette_lib import GENERATOR_VERSION
    except ImportError:
        GENERATOR_VERSION = 0
    return f"{seed}|{GENERATOR_VERSION}"


def kread(file, group, key):
    r = subprocess.run(["kreadconfig6", "--file", file, "--group", group, "--key", key],
                       capture_output=True, text=True)
    return r.stdout.strip()


def theme_name(family, style):
    return f"Aedwen-{family.capitalize()}-{style.capitalize()}"


def parse(name):
    """(family, style) of an Aedwen-<Family>-<Style> theme name, else None."""
    parts = name.split("-")
    if len(parts) == 3 and parts[0] == "Aedwen":
        family, style = parts[1].lower(), parts[2].lower()
        if family in FAMILIES and style in STYLES:
            return family, style
    return None


def accent_seed():
    """Seed colour for the current KDE accent (AccentColor is "r,g,b")."""
    from palette_lib import DEFAULT_SEED, SEED_HEX, seed_hex_for

    rgb = kread("kdeglobals", "General", "AccentColor")
    try:
        r, g, b = (int(v) for v in rgb.split(",")[:3])
    except ValueError:
        return SEED_HEX[DEFAULT_SEED]
    return seed_hex_for(f"#{r:02x}{g:02x}{b:02x}")


def build(family, style, seed):
    name = theme_name(family, style)
    out = os.path.join(DATA, "icons", name)
    subprocess.run([sys.executable, os.path.join(LIB, "generate-cursors.py"),
                    "--family", family, "--style", style, "--accent", seed,
                    "--name", name, "--out", out], check=True)
    os.makedirs(CACHE, exist_ok=True)
    with open(STAMP, "w") as f:
        f.write(stamp_for(seed) + "\n")
    return name


def apply(name, size=None):
    cmd = ["plasma-apply-cursortheme", name]
    if size:
        cmd += ["--size", str(size)]
    subprocess.run(cmd, check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--family", choices=FAMILIES)
    ap.add_argument("--style", choices=STYLES)
    ap.add_argument("--size", type=int, choices=SIZES)
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--list", action="store_true")
    args = ap.parse_args()

    if args.list:
        for f in FAMILIES:
            for s in STYLES:
                print(theme_name(f, s) + ("  (built from the accent colour)" if s in GENERATED else ""))
        return

    if args.refresh:
        current = kread("kcminputrc", "Mouse", "cursorTheme")
        parsed = parse(current)
        if not parsed or parsed[1] not in GENERATED:
            return
        seed = accent_seed()
        try:
            with open(STAMP) as f:
                if f.read().strip() == stamp_for(seed):
                    return
        except OSError:
            pass
        build(*parsed, seed)
        # same name: re-apply so running apps pick up the new colours
        apply(current)
        return

    if not args.family or not args.style:
        ap.error("--family and --style are required (or --refresh / --list)")
    if args.style in GENERATED:
        for tool in ("rsvg-convert", "xcursorgen"):
            if not shutil.which(tool):
                sys.exit(f"aedwen-cursors: {tool} is missing")
        name = build(args.family, args.style, accent_seed())
    else:
        name = theme_name(args.family, args.style)
    apply(name, args.size)


if __name__ == "__main__":
    main()
