#!/usr/bin/env python3
"""
Tint the colours Konsole and Kate keep for themselves (the terminal colour
scheme + profile and the editor themes), and the default wallpaper, to the
seed colour.

The ISO ships the violet versions (/usr/share/konsole, and
/usr/share/org.kde.syntax-highlighting/themes). Any other accent is drawn
here, into ~/.local/share, by the same generator the ISO build uses
(/usr/lib/aedwen/generate-app-themes.py), from the current KDE accent colour
and the [AedwenOS] Variant and Contrast keys in kdeglobals (High contrast
gives black terminal/editor themes and a high-contrast libadwaita
stylesheet). Okular, Gwenview and the rest
of Kate follow the Plasma colour scheme, so they need nothing here.

The wallpaper (generate-desktop-wallpaper.py -> ~/.local/share/wallpapers/
AedwenOS-User, dark and light images; Plasma picks by colour scheme) is only
built and applied while the desktop still shows an AedwenOS wallpaper, so a
wallpaper you chose yourself is never replaced.

    aedwen-apps --refresh    # rebuild if the accent / variant changed (run by
                             # aedwen-cursor-accent.path and the Appearance
                             # settings)
    aedwen-apps --force      # rebuild regardless
"""

import argparse
import os
import subprocess
import sys

LIB = "/usr/lib/aedwen"
sys.path.insert(0, LIB)

DATA = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "aedwen")
STAMP = os.path.join(CACHE, "apps-accent")
WALLPAPER = "AedwenOS-User"


def kread(file, group, key):
    r = subprocess.run(["kreadconfig6", "--file", file, "--group", group, "--key", key],
                       capture_output=True, text=True)
    return r.stdout.strip()


def accent_seed():
    """Seed colour for the current KDE accent (AccentColor is "r,g,b")."""
    from palette_lib import DEFAULT_SEED, SEED_HEX, seed_hex_for

    rgb = kread("kdeglobals", "General", "AccentColor")
    try:
        r, g, b = (int(v) for v in rgb.split(",")[:3])
    except ValueError:
        return SEED_HEX[DEFAULT_SEED]
    return seed_hex_for(f"#{r:02x}{g:02x}{b:02x}")


def is_dark():
    theme = kread("kdeglobals", "AedwenOS", "Theme")
    if theme in ("dark", "light"):
        return theme == "dark"
    # auto: whichever colour scheme is active
    return "light" not in kread("kdeglobals", "General", "ColorScheme").lower()


def generator_version():
    """palette_lib.GENERATOR_VERSION: changes when an update changes the
    generators, so the files are redrawn even if the accent did not change."""
    try:
        from palette_lib import GENERATOR_VERSION
        return GENERATOR_VERSION
    except ImportError:
        return 0


def settings():
    variant = kread("kdeglobals", "AedwenOS", "Variant")
    contrast = kread("kdeglobals", "AedwenOS", "Contrast")
    return (accent_seed(),
            variant if variant in ("baseline", "expressive") else "expressive",
            is_dark(),
            "high" if contrast == "high" else "standard",
            generator_version())


def wallpaper_is_ours():
    """True when the desktop shows an AedwenOS wallpaper (or none was set yet)."""
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                        "plasma-org.kde.plasma.desktop-appletsrc")
    try:
        with open(path) as f:
            images = [l.split("=", 1)[1].strip() for l in f if l.startswith("Image=")]
    except OSError:
        return True
    return all(i.rstrip("/").rsplit("/", 1)[-1] in ("AedwenOS", "AedwenOS-User") for i in images)


def build_wallpaper(seed):
    out = os.path.join(DATA, "wallpapers", WALLPAPER)
    subprocess.run([sys.executable, os.path.join(LIB, "generate-desktop-wallpaper.py"),
                    "--accent", seed, "--id", WALLPAPER, "--out", out],
                   check=True, stdout=subprocess.DEVNULL)
    # Plasma re-reads the images when the package is applied again
    subprocess.run(["plasma-apply-wallpaperimage", WALLPAPER],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


GTK4_CSS = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "gtk-4.0", "gtk.css")
GTK_MARK = "AedwenOS libadwaita overrides"


def build_gtk(seed, variant, contrast):
    """libadwaita apps take their colours from ~/.config/gtk-4.0/gtk.css: write
    the one for this accent and contrast. Only if it is empty or one we wrote:
    a stylesheet the user made themselves is left alone."""
    script = os.path.join(LIB, "generate-gtk-theme.py")
    try:
        with open(GTK4_CSS) as f:
            head = f.read(200)
    except OSError:
        head = GTK_MARK
    if not os.path.exists(script) or (head.strip() and GTK_MARK not in head):
        return
    subprocess.run([sys.executable, script, "--accent", seed, "--variant", variant,
                    "--contrast", contrast, "--libadwaita-out", GTK4_CSS],
                   check=False, stdout=subprocess.DEVNULL)


def build(seed, variant, dark, contrast, version=0):
    build_gtk(seed, variant, contrast)
    cmd = [sys.executable, os.path.join(LIB, "generate-app-themes.py"),
           "--accent", seed, "--variant", variant, "--contrast", contrast,
           "--konsole", os.path.join(DATA, "konsole"),
           "--kate", os.path.join(DATA, "org.kde.syntax-highlighting", "themes")]
    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
    if wallpaper_is_ours():
        build_wallpaper(seed)
    os.makedirs(CACHE, exist_ok=True)
    with open(STAMP, "w") as f:
        f.write("|".join(map(str, (seed, variant, dark, contrast, version))) + "\n")
    # Kate picks its editor theme by name: follow light/dark, unless the user
    # chose some other theme themselves
    for rc in ("katerc", "kwriterc"):
        cur = kread(rc, "KTextEditor Renderer", "Color Theme")
        if cur == "" or cur.startswith("AedwenOS"):
            subprocess.run(["kwriteconfig6", "--file", rc, "--group", "KTextEditor Renderer",
                            "--key", "Color Theme", "AedwenOS " + ("Dark" if dark else "Light")],
                           check=False)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--refresh", action="store_true")
    ap.add_argument("--force", action="store_true")
    args = ap.parse_args()
    if not (args.refresh or args.force):
        ap.error("--refresh or --force is required")

    want = settings()
    try:
        with open(STAMP) as f:
            stamp = f.read().strip()
    except OSError:
        stamp = ""
    if not args.force and stamp == "|".join(map(str, want)):
        return
    build(*want)


if __name__ == "__main__":
    main()
