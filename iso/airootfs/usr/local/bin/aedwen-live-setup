#!/usr/bin/env bash
# Creates the passwordless live user on first boot of the live medium.
set -euo pipefail

grep -qx /usr/bin/fish /etc/shells || echo /usr/bin/fish >> /etc/shells

if ! id aedwen &>/dev/null; then
    useradd --create-home --uid 1000 --user-group \
            --groups wheel,network,video,audio,storage,input \
            --shell /usr/bin/fish aedwen
fi

# passwordless login for the live session
passwd --delete aedwen
passwd --delete root

# xdg-user-dirs ships an autostart entry that creates ~/Desktop, ~/Documents,
# etc. at session start, but that races Plasma's desktop containment loading
# before it runs, producing a "the file or folder ~/Desktop does not exist"
# error on first login. Create them here instead, before sddm/the session
# ever starts.
runuser -u aedwen -- xdg-user-dirs-update

# Kickoff's application grid reads the AppStream metadata cache; nothing
# populates it by default on the live medium (unlike the installed system,
# which gets a pacman hook -- see aedwen-install / shellprocess-postinstall),
# so the grid stays empty until this runs once.
appstreamcli refresh-cache --force || true

# regenerate locale (locale.gen is shipped by the profile)
locale-gen || true

# Refresh the mirrorlist for local speed when the network is up. The shipped
# /etc/pacman.d/mirrorlist already has working worldwide mirrors, so this is
# best-effort only -- pacman/paru work regardless.
if command -v reflector >/dev/null; then
    timeout 60 reflector --save /etc/pacman.d/mirrorlist --protocol https \
             --download-timeout 5 --latest 20 --sort rate || true
fi

touch /var/lib/aedwen-live-setup.done
