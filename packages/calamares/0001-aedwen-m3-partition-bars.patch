+// AedwenOS: the design's "After install" bar -- flat segments, 3 px gaps
+// between them, 3 px inner corners and rounded outer ends (the connected-
+// button rule), no border or gloss. Hover adds an 8 % state layer, the
+// selected segment gets a 2 px on-surface ring.
+static QPainterPath
+segmentPath( const QRectF& r, qreal left, qreal right )
+{
+    left = qMin( left, qMin( r.width(), r.height() ) / 2 );
+    right = qMin( right, qMin( r.width(), r.height() ) / 2 );
+    QPainterPath path;
+    path.moveTo( r.left() + left, r.top() );
+    path.lineTo( r.right() - right, r.top() );
+    path.quadTo( r.right(), r.top(), r.right(), r.top() + right );
+    path.lineTo( r.right(), r.bottom() - right );
+    path.quadTo( r.right(), r.bottom(), r.right() - right, r.bottom() );
+    path.lineTo( r.left() + left, r.bottom() );
+    path.quadTo( r.left(), r.bottom(), r.left(), r.bottom() - left );
+    path.lineTo( r.left(), r.top() + left );
+    path.quadTo( r.left(), r.top(), r.left() + left, r.top() );
+    path.closeSubpath();
+    return path;
+}
